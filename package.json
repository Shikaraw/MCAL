{
  "name": "minecraft-agent-launcher",
  "productName": "MCAL",
  "version": "0.1.0",
  "description": "MCAL · Minecraft Agent Launcher — 面向 AI 时代的 Minecraft 智能启动器",
  "main": "./out/main/index.js",
  "author": "MCAL Project",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "icon": "node scripts/gen-icon.mjs",
    "verify:pack": "node scripts/verify-asar.mjs",
    "verify:asar": "electron scripts/check-asar-read.cjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder && npm run verify:pack",
    "dist:win": "npm run build && electron-builder --win && npm run verify:pack"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "iconv-lite": "^0.7.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^5.0.0",
    "zustand": "^5.0.0"
  },
  "build": {
    "appId": "com.mcal.launcher",
    "productName": "MCAL",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "resources/knowledge/**/*",
      "resources/skills/**/*",
      "resources/templates/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "resources/icon.png",
      "category": "public.app-category.games"
    },
    "linux": {
      "target": "AppImage",
      "icon": "resources/icon.png",
      "category": "Game"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "portable": {
      "artifactName": "MCAL Portable ${version}.${ext}"
    }
  }
}
